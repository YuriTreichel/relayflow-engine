{
	"info": {
		"_postman_id": "c62391ea-72f1-4db8-8d48-8df3114d6829",
		"name": "RelayFlow Engine API",
		"description": "Collection of API endpoints for RelayFlow Engine, including webhook triggers with HMAC SHA-256 validation, Rate Limiting, and DAG workflow execution.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Execute Workflow Webhook (HMAC Secured)",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const timestamp = Math.floor(Date.now() / 1000);",
							"const payload = pm.request.body.raw || '{}';",
							"const secret = pm.environment.get('APP_KEY') || 'base64:YOUR_APP_KEY';",
							"const payloadToSign = timestamp + '.' + payload;",
							"const signature = CryptoJS.HmacSHA256(payloadToSign, secret).toString();",
							"",
							"pm.request.headers.upsert({ key: 'X-RelayFlow-Timestamp', value: timestamp.toString() });",
							"pm.request.headers.upsert({ key: 'X-RelayFlow-Signature', value: signature });"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "X-RelayFlow-Signature",
						"value": "{{signature}}"
					},
					{
						"key": "X-RelayFlow-Timestamp",
						"value": "{{timestamp}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"event\": \"order.created\",\n  \"order\": {\n    \"id\": \"ORD-98214\",\n    \"total\": 750.00,\n    \"customer_email\": \"customer@example.com\"\n  }\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/workflows/1/execute",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"workflows",
						"1",
						"execute"
					]
				},
				"description": "Triggers an active workflow via webhook. Evaluates DAG conditional nodes and routes execution accordingly."
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000"
		}
	]
}
